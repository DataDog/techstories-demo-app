{
  "name": "techstories_ci_testvisibility_workshop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "next build --webpack",
    "dev": "NODE_OPTIONS='--require dd-trace/init' next dev -H 0.0.0.0 --webpack",
    "postinstall": "prisma generate",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "NODE_OPTIONS='--require dd-trace/init' next start",
    "db-create": "prisma db push",
    "db-seed": "NODE_ENV=development prisma db seed",
    "db-prep": "npm run db-create && npm run db-seed && npm run postinstall",
    "test": "NODE_OPTIONS=\"--max-old-space-size=12288 ${NODE_OPTIONS:-}\" jest",
    "test:watch": "jest --watch",
    "test:ci": "NODE_OPTIONS=\"--max-old-space-size=12288 ${NODE_OPTIONS:-}\" jest --ci --detectOpenHandles --coverage --collectCoverageFrom=src/**/*.{ts,tsx}",
    "test:integration": "NODE_OPTIONS=\"--max-old-space-size=12288 ${NODE_OPTIONS:-}\" jest src/__tests__/integration",
    "e2e": "cypress open --e2e",
    "e2e:headless": "start-server-and-test 'npm run dev' 3000 'cypress run --e2e --browser chromium --headless'",
    "test:components": "jest --selectProjects components",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@datadog/browser-logs": "7.11.0",
    "@datadog/browser-rum": "7.11.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-query": "5.102.8",
    "@trpc/client": "11.18.0",
    "@trpc/next": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "@uiw/react-md-editor": "^4.1.2",
    "bcrypt": "^5.1.1",
    "dd-trace": "5.124.0",
    "dotenv": "^16.6.1",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-remove-imports": "^1.0.13",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "superjson": "^2.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@datadog/datadog-ci": "^5.23.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/parser": "^8.69.0",
    "babel-jest": "^30.5.1",
    "cypress": "15.21.1",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.4",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "jest-fetch-mock": "^3.0.3",
    "node-mocks-http": "^1.17.2",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "4.3.3",
    "ts-jest": "^29.4.6",
    "tsx": "^4.23.3",
    "typescript": "5.9.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.12.0"
  }
}
